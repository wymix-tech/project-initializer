<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>${parentGroupId}</groupId>
        <artifactId>${parentArtifactId}</artifactId>
        <version>${parentVersion}</version>
        <relativePath/>
    </parent>
    <groupId>${group}</groupId>
    <artifactId>${artifact}</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>${artifact}</name>
    <description>Generated by project-initializer</description>

    <properties>
        <java.version>${javaVersion}</java.version>
    </properties>

    <dependencies>
        <#-- starter 依赖由 metadata.yml starters 节的坐标映射驱动，新增 starter 无需改模板；
             声明了 version 的依赖（如内部 starter，不在 Boot BOM 管理范围）显式输出版本 -->
        <#list starterDependencies as dep>
        <dependency>
            <groupId>${dep.groupId}</groupId>
            <artifactId>${dep.artifactId}</artifactId>
<#if dep.version?? && dep.version != ''>
            <version>${dep.version}</version>
</#if>
        </dependency>
        </#list>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
