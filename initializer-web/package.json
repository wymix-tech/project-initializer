{
  "name": "initializer-web",
  "version": "0.1.0",
  "description": "项目初始化器前端（Vue 3 + TypeScript + Vite）",
  "scripts": {
    "test": "vitest run",
    "build": "vite build",
    "dev": "vite",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "patch-package && stryker run",
    "typecheck": "vue-tsc --noEmit",
    "postinstall": "patch-package",
    "test:e2e": "npm run build && playwright test",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "pinia": "^2.3.1",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@stryker-mutator/core": "^8.7.1",
    "@stryker-mutator/vitest-runner": "^8.7.1",
    "@types/node": "^26.4.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^3.2.7",
    "@vue/test-utils": "^2.5.0",
    "jsdom": "^30.0.1",
    "patch-package": "^8.0.1",
    "typescript": "^5.6.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7",
    "vue-tsc": "^3.3.11"
  }
}
